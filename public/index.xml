				<description>&lt;h1 id=&#34;title&#34;&gt;About&lt;/h1&gt;&#xA;&lt;div class=&#34;profile-card&#34;&gt;&#xA;    &lt;div&gt;&#xA;        &lt;img src=&#34;http://localhost:1313/images/picture.png&#34; id=&#34;profile&#34; title=&#34;Muslim EduFest — ICE BSD, Tangerang (29/08/26)&#34;&gt;&#xA;    &lt;/div&gt;&#xA;        &lt;div class=&#34;card&#34; style=&#34;flex: 1; min-width: 0;&#34;&gt;&#xA;            &lt;div class=&#34;namerow&#34;&gt;&#xA;                &lt;h1 id=&#34;name&#34;&gt;Rauf Deriel&lt;/h1&gt;&#xA;                &lt;div class=&#34;smallcard&#34; id=&#34;quote&#34;&gt;&#xA;                    &lt;span&gt;&lt;i&gt;&#34;Be in this world as if you are a stranger or a wayfarer.&#34; (Al-Bukhāri)&lt;/i&gt;&lt;/span&gt;&#xA;                &lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div style=&#34;text-align: left;&#34;&gt;&#xA;                &lt;div class=&#34;info-row&#34;&gt;&lt;i&gt;A Salafi layman — not righteous — seeker of knowledge, aspiring Dā‘ī to the Path of Allāh.&lt;/i&gt;&lt;/div&gt;&#xA;                &lt;div class=&#34;info-row&#34;&gt;&lt;strong&gt;Origin&lt;/strong&gt; Indonesia&lt;/div&gt;&#xA;                &lt;div class=&#34;info-row&#34; id=&#34;lang&#34;&gt;&#xA;                    &lt;strong&gt;Languages&lt;/strong&gt;&#xA;                    &lt;span&gt;🇮🇩 Bahasa Indonesia — &lt;/span&gt;&#xA;                    &lt;span&gt;🇬🇧 English — &lt;/span&gt;&#xA;                    &lt;span&gt;🇸🇦 العربية&lt;/span&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;div class=&#34;socials-container&#34;&gt;&#xA;                    &lt;div class=&#34;socials-label&#34;&gt;&lt;strong&gt;Socials&lt;/strong&gt;&lt;/div&gt;&#xA;                    &lt;div class=&#34;socials-icons&#34;&gt;&#xA;                        &lt;a href=&#34;mailto:raufderiel@gmail.com&#34; title=&#34;Mail: raufderiel@gmail.com&#34;&gt;&#xA;                            &lt;svg width=&#34;22px&#34; height=&#34;22px&#34; viewBox=&#34;0 0 24 2